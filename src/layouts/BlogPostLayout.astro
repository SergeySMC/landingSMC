---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, cover, coverAlt, pubDate, updatedDate } = post.data;
---

<BaseLayout
  title={`${title} — Soul Mind Cards`}
  description={description}
  ogType="article"
>
  <Header />
  <main id="main">
    <article class="prose">
      <header class="prose-header">
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {updatedDate && (
          <time datetime={updatedDate.toISOString()}>
            обновлено {updatedDate.toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        )}
        <h1>{title}</h1>
      </header>
      <slot />
    </article>
  </main>
  <Footer />
</BaseLayout>

<style>
  main {
    max-width: 740px;
    margin: 0 auto;
    padding: clamp(32px, 5vw, 64px) clamp(20px, 5vw, 72px);
  }

  .prose-header {
    margin-bottom: 40px;
  }

  .prose-header time {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    color: var(--muted);
  }

  .prose-header time + time::before {
    content: ' · ';
  }

  .prose-header h1 {
    margin: 16px 0 0;
    font-family: Lora, Georgia, serif;
    font-weight: 400;
    font-size: clamp(28px, 4.5vw, 42px);
    line-height: 1.2;
  }

  /* Типографика тела статьи — :global() для контента из <Content /> */
  .prose :global(h2) {
    font-family: Lora, Georgia, serif;
    font-weight: 500;
    font-size: 24px;
    line-height: 1.3;
    margin: 48px 0 16px;
  }

  .prose :global(h3) {
    font-family: Lora, Georgia, serif;
    font-weight: 500;
    font-size: 20px;
    line-height: 1.35;
    margin: 36px 0 12px;
  }

  .prose :global(p) {
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink2);
    margin: 0 0 18px;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--line2);
    padding-left: 20px;
    margin: 24px 0;
    color: var(--muted);
    font-style: italic;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 24px;
    margin: 0 0 18px;
    color: var(--ink2);
    font-size: 17px;
    line-height: 1.7;
  }

  .prose :global(li) {
    margin-bottom: 6px;
  }

  .prose :global(code) {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 14px;
    background: var(--surface);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .prose :global(pre) {
    background: var(--surface);
    padding: 20px;
    border-radius: 8px;
    overflow-x: auto;
    margin: 24px 0;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    margin: 24px 0;
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :global(a:hover) {
    color: var(--accent-h);
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 40px 0;
  }
</style>
