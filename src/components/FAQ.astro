---
const faq = [
  { q: 'Я никогда не была у психолога. Это нормально?', a: 'Да. Начнём со знакомства: расскажете своими словами, я задам уточняющие вопросы. Ничего готовить заранее не нужно.' },
  { q: 'Карты — это точно не гадание?', a: 'Нет. Карты не содержат предсказаний. Это набор изображений, который помогает вам говорить о себе.' },
  { q: 'Онлайн работает так же, как лично?', a: 'Для работы с МАК — да. На платформе мы видим одну раскладку, и вы вытягиваете карты сами.' },
  { q: 'Что нужно для сессии?', a: 'Ноутбук или телефон, наушники и место, где вас час не потревожат. Ссылка приходит перед встречей.' },
  { q: 'Как оплатить и можно ли перенести?', a: 'Оплата после подтверждения времени. Перенести встречу можно не позднее чем за 12 часов.' },
];
---

<section id="faq" class="faq">
  <h2>Частые вопросы</h2>
  <div class="list">
    {faq.map((item) => (
      <div class="item">
        <h3>{item.q}</h3>
        <p>{item.a}</p>
      </div>
    ))}
  </div>
</section>

<style>
  /* Стили будут заполнены в Фазе 4 */
</style>
