---
const tgLink = 'https://t.me/soulmindcards';
const tgDm = 'https://t.me/Soul_mind_cards';
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <p class="kicker">Онлайн-сессии с метафорическими ассоциативными картами</p>
  <h1>Разобраться в сложной ситуации с помощью МАК</h1>
  <p class="lead">
    Онлайн-сессии с психологом, где МАК-карты помогают по-новому посмотреть на отношения, выбор, самооценку и телесные реакции.
  </p>
  <div class="cta-group">
    <a href={tgDm} class="btn-primary">Записаться на прием</a>
<a href={tgLink} class="btn-secondary">Пройти бесплатную практику с МАК →</a>
  </div>
  <p class="note">Первичная консультация-знакомство — 20 минут, бесплатно</p>
</section>

<section class="hero-photo">
  <img src={`${base}hero-photo.jpg`} alt="Раскладка МАК-карт на столе, крупный план рук" width="1120" height="400" loading="eager" />
</section>

<style>
  .hero {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(30px, 5.25vw, 63px) clamp(20px, 5vw, 72px) clamp(24px, 3.4vw, 42px);
    text-align: center;
  }

  .kicker {
    margin: 0 0 26px;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-soft);
  }

  h1 {
    margin: 0;
    font-family: Lora, Georgia, serif;
    font-weight: 400;
    font-size: clamp(33px, 6vw, 60px);
    line-height: 1.14;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .lead {
    margin: 28px auto 0;
    max-width: 600px;
    font-size: clamp(16px, 2.1vw, 19px);
    line-height: 1.65;
    color: var(--ink2);
    text-wrap: pretty;
  }

  .cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
    margin-top: 32px;
  }

  .btn-primary {
    padding: 15px 30px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 16px;
    font-weight: 400;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: background 0.15s;
  }

  .btn-primary:hover {
    background: var(--accent-h);
    color: var(--on-accent);
  }

  .btn-secondary {
    padding: 15px 30px;
    border-radius: 999px;
    border: 1px solid var(--line2);
    color: var(--ink);
    font-size: 16px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--ink);
  }

  .note {
    margin: 22px 0 0;
    font-size: 14px;
    color: var(--faint);
  }

  .hero-photo {
    padding: 0 clamp(20px, 5vw, 72px) clamp(30px, 4.5vw, 51px);
    max-width: 1120px;
    margin: 0 auto;
  }

  .hero-photo img {
    width: 75%;
    height: auto;
    display: block;
    margin: 0 auto;
  }
</style>
