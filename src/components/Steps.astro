---
const tgLink = 'https://t.me/julia_mak';
const steps = [
  { num: 'Шаг 1', title: 'Знакомство', text: '20 минут: вы рассказываете, что происходит, я объясняю, как работаю. Бесплатно.' },
  { num: 'Шаг 2', title: 'Запрос', text: 'Формулируем, с чем работаем и к чему хотим прийти. Это уже часть терапии.' },
  { num: 'Шаг 3', title: 'Работа с картами', text: 'Вы вытягиваете карты в общем окне платформы, описываете образы, я задаю вопросы.' },
  { num: 'Шаг 4', title: 'Итог встречи', text: 'Собираем, что стало ясно, и договариваемся о небольшом шаге до следующей сессии.' },
];
---

<section id="sessia" class="steps">
  <h2>Как проходит сессия</h2>
  <div class="grid">
    {steps.map((s) => (
      <div class="step">
        <span class="num">{s.num}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </div>
    ))}
  </div>
  <a href={tgLink} class="btn-primary">Записаться на сеанс</a>
</section>

<style>
  /* Стили будут заполнены в Фазе 4 */
</style>
