---
const tgLink = 'https://t.me/julia_mak';
const steps = [
  { num: 'Шаг 1', title: 'Знакомство', text: '20 минут: вы рассказываете, что происходит, я объясняю, как работаю. Бесплатно.' },
  { num: 'Шаг 2', title: 'Запрос', text: 'Формулируем, с чем работаем и к чему хотим прийти. Это уже часть терапии.' },
  { num: 'Шаг 3', title: 'Работа с картами', text: 'Вы вытягиваете карты в общем окне платформы, описываете образы, я задаю вопросы.' },
  { num: 'Шаг 4', title: 'Итог встречи', text: 'Собираем, что стало ясно, и договариваемся о небольшом шаге до следующей сессии.' },
];
---

<section id="sessia" class="steps">
  <h2>Как проходит сессия</h2>
  <div class="grid">
    {steps.map((s) => (
      <div class="step">
        <span class="num">{s.num}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </div>
    ))}
  </div>
  <a href={tgLink} class="btn-primary">Записаться на сеанс</a>
</section>

<style>
  .steps {
    padding: clamp(40px, 5.5vw, 66px) clamp(20px, 5vw, 72px);
    max-width: 1120px;
    margin: 0 auto;
    border-top: 1px solid var(--line);
  }

  h2 {
    margin: 0 0 36px;
    font-family: Lora, Georgia, serif;
    font-weight: 400;
    font-size: clamp(26px, 3.6vw, 38px);
    line-height: 1.22;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: clamp(26px, 3.5vw, 48px);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .num {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    color: var(--accent-soft);
  }

  h3 {
    margin: 0;
    font-family: Lora, Georgia, serif;
    font-weight: 500;
    font-size: 19px;
    line-height: 1.3;
  }

  .step p {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  .btn-primary {
    margin-top: 36px;
    padding: 15px 30px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 16px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: background 0.15s;
  }

  .btn-primary:hover {
    background: var(--accent-h);
    color: var(--on-accent);
  }
</style>
