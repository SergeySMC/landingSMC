---
const topics = [
  { num: '01', title: 'Повторяющиеся сценарии', text: 'Почему в отношениях всё повторяется, а в финансах не получается выйти за привычный предел — даже когда вы всё понимаете?' },
  { num: '02', title: 'Усталость и трудный выбор', text: 'Тащите на себе всё: проекты, быт, заботу о близких. Стоите перед мучительной развилкой — менять жизнь или продолжать терпеть.' },
  { num: '03', title: 'Точка, в которой вы застряли', text: 'Вы многое понимаете, работаете над собой, но ситуация всё равно не меняется. С помощью МАК можно быстро увидеть, что стоит за этим внутренним стопом и что сейчас не даёт сделать следующий шаг.' },
  { num: '04', title: 'Острый жизненный тупик', text: 'Оказались в ситуационном тупике и ищете наглядное решение конкретной проблемы «здесь и сейчас».' },
  { num: '05', title: 'Психосоматика и телесные реакции', text: 'Тело реагирует напряжением, усталостью или неприятными ощущениями, хотя явной причины не находят.' },
  { num: '06', title: 'Сомнения и самооценка', text: 'Сложно опереться на себя, страшно сделать ошибку, а внутренний критик не дает сделать шаг вперед.' },
];
---

<section id="zapros" class="topics">
  <h2>Запросы, с которыми я работаю</h2>
  <p class="lead">Если хотя бы одна строка описывает ваше состояние — это точка, с которой можно начать изменения.</p>
  <div class="grid">
    {topics.map((t) => (
      <div class="card">
        <span class="num">{t.num}</span>
        <h3>{t.title}</h3>
        <p>{t.text}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .topics {
    padding: 0 clamp(20px, 5vw, 72px) clamp(30px, 4.5vw, 51px);
    max-width: 1120px;
    margin: 0 auto;
  }

  h2 {
    margin: 0 0 16px;
    font-family: Lora, Georgia, serif;
    font-weight: 400;
    font-size: clamp(26px, 3.6vw, 38px);
    line-height: 1.22;
  }

  .lead {
    margin: 0 0 36px;
    max-width: 540px;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: clamp(24px, 3vw, 40px);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 11px;
    border-top: 1px solid var(--line2);
    padding-top: 20px;
  }

  .num {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--accent-soft);
  }

  h3 {
    margin: 0;
    font-family: Lora, Georgia, serif;
    font-weight: 500;
    font-size: 19px;
    line-height: 1.3;
  }

  .card p {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
