---
const topics = [
  { num: '01', title: 'Не понимаю, чего хочу', text: 'Решение принято головой, но внутри нет согласия. Разбираем, что стоит за этим несогласием.' },
  { num: '02', title: 'Отношения по кругу', text: 'Одни и те же сценарии с разными людьми. Смотрим, какая роль в них ваша.' },
  { num: '03', title: 'Устала, но не могу остановиться', text: 'Выгорание, чувство вины за отдых, жизнь на автопилоте.' },
  { num: '04', title: 'Тревога без причины', text: 'Постоянное напряжение, которое трудно объяснить словами и потому трудно снять.' },
  { num: '05', title: 'Точка перехода', text: 'Переезд, смена работы, развод, взрослые дети. Нужно опереться на что-то своё.' },
  { num: '06', title: 'Трудно говорить о себе', text: 'Если прямые вопросы вызывают ступор — карты дают безопасный обходной путь.' },
];
---

<section id="zapros" class="topics">
  <h2>С чем ко мне приходят</h2>
  <p class="lead">Если узнали себя хотя бы в одном пункте — нам есть о чём поговорить.</p>
  <div class="grid">
    {topics.map((t) => (
      <div class="card">
        <span class="num">{t.num}</span>
        <h3>{t.title}</h3>
        <p>{t.text}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .topics {
    padding: 0 clamp(20px, 5vw, 72px) clamp(40px, 6vw, 68px);
    max-width: 1120px;
    margin: 0 auto;
  }

  h2 {
    margin: 0 0 16px;
    font-family: Lora, Georgia, serif;
    font-weight: 400;
    font-size: clamp(26px, 3.6vw, 38px);
    line-height: 1.22;
  }

  .lead {
    margin: 0 0 36px;
    max-width: 540px;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: clamp(24px, 3vw, 40px);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 11px;
    border-top: 1px solid var(--line2);
    padding-top: 20px;
  }

  .num {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--accent-soft);
  }

  h3 {
    margin: 0;
    font-family: Lora, Georgia, serif;
    font-weight: 500;
    font-size: 19px;
    line-height: 1.3;
  }

  .card p {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
