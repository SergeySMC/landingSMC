---
const topics = [
  { num: '01', title: 'Повторяющиеся сценарии', text: 'Ходите по замкнутому кругу в отношениях или уперлись в финансовый потолок, хотя головой все понимаете.' },
  { num: '02', title: 'Усталость и выбор на износ', text: 'Тащите на себе проекты, быт и семью. Стоите перед мучительным выбором: менять жизнь или терпеть дальше.' },
  { num: '03', title: 'Терапия есть, а прорыва нет', text: 'Многое понимаете, но ситуация не меняется: хотите без лишних теорий увидеть, что не дает двигаться дальше прямо сейчас.' },
  { num: '04', title: 'Острый жизненный тупик', text: 'Оказались в ситуационном тупике и ищете наглядное решение конкретной проблемы «здесь и сейчас».' },
  { num: '05', title: 'Психосоматика и телесные реакции', text: 'Анализы и обследования в норме, но тело сигналит зажимами, комом в горле, болями или резкой утомляемостью.' },
  { num: '06', title: 'Сомнения и самооценка', text: 'Сложно опереться на себя, страшно сделать ошибку, а внутренний критик не дает сделать шаг вперед.' },
];
---

<section id="zapros" class="topics">
  <h2>Конкретные ситуации, с которыми я работаю</h2>
  <p class="lead">Если хотя бы одна строка описывает ваше состояние прямо сейчас — за ней стоит конкретное решение.</p>
  <div class="grid">
    {topics.map((t) => (
      <div class="card">
        <span class="num">{t.num}</span>
        <h3>{t.title}</h3>
        <p>{t.text}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .topics {
    padding: 0 clamp(20px, 5vw, 72px) clamp(40px, 6vw, 68px);
    max-width: 1120px;
    margin: 0 auto;
  }

  h2 {
    margin: 0 0 16px;
    font-family: Lora, Georgia, serif;
    font-weight: 400;
    font-size: clamp(26px, 3.6vw, 38px);
    line-height: 1.22;
  }

  .lead {
    margin: 0 0 36px;
    max-width: 540px;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: clamp(24px, 3vw, 40px);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 11px;
    border-top: 1px solid var(--line2);
    padding-top: 20px;
  }

  .num {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--accent-soft);
  }

  h3 {
    margin: 0;
    font-family: Lora, Georgia, serif;
    font-weight: 500;
    font-size: 19px;
    line-height: 1.3;
  }

  .card p {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
