---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Блог — Soul Mind Cards"
  description="Статьи о метафорических ассоциативных картах, психологии и работе с собой."
>
  <Header />
  <main class="blog-list">
    <h1>Блог</h1>
    {posts.length === 0 && <p class="empty">Статьи скоро появятся.</p>}
    <ul>
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`}>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </main>
  <Footer />
</BaseLayout>

<style>
  .blog-list {
    max-width: 740px;
    margin: 0 auto;
    padding: clamp(32px, 5vw, 64px) clamp(20px, 5vw, 72px);
  }

  .blog-list h1 {
    font-family: Lora, Georgia, serif;
    font-weight: 400;
    font-size: clamp(28px, 4.5vw, 42px);
    margin: 0 0 40px;
  }

  .empty {
    color: var(--muted);
    font-size: 17px;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  li a {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }

  li:first-child a {
    border-top: none;
    padding-top: 0;
  }

  li a:hover h2 {
    color: var(--accent);
  }

  time {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    color: var(--muted);
  }

  h2 {
    margin: 8px 0 6px;
    font-family: Lora, Georgia, serif;
    font-weight: 500;
    font-size: 22px;
    line-height: 1.3;
    transition: color 0.15s;
  }

  p {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--muted);
  }
</style>
